{
  "dashboard": {
    "path": "/",
    "file": "dashboard.html",
    "tiles": [
      { "key": "active", "filter": "current" },
      { "key": "quotesOpen", "filter": "quotesOpen" },
      { "key": "acceptedNotStarted", "filter": "acceptedNotStarted" },
      { "key": "invoicesOpen", "filter": "invoicesOpen" },
      { "key": "ended", "filter": "end" }
    ],
    "lists": [
      { "key": "acceptedNotStarted", "detail": "quoteAccepted" },
      { "key": "quotesOpen", "detail": "quoteSent" },
      { "key": "invoicesOpen", "detail": "invoiceSent" }
    ]
  },
  "insights": {
    "path": "/insights",
    "file": "insights.html",
    "table": {
      "columns": ["material", "method", "runs", "avgMinutes", "lastRun"]
    }
  },
  "customers": {
    "path": "/customers",
    "file": "customers.html",
    "card": {
      "title": "name",
      "fields": ["email", "phone"],
      "count": "projectCount"
    }
  },
  "project": {
    "path": "/project/:id",
    "file": "project.html",
    "nav": false
  },
  "projects": {
    "path": "/projects",
    "file": "projects.html",
    "row": {
      "title": "customerName",
      "fields": ["status", "prospectDate", "startDate", "endDate", "quoteSent", "quoteAccepted", "invoiceSent", "invoicePaid", "invoiceNumber"],
      "link": "folderUrl",
      "subtitle": "projectId",
      "filters": ["current", "all", "quotesOpen", "acceptedNotStarted", "invoicesOpen", "prospect", "start", "ongoing", "end"],
      "defaultFilter": "current",
      "editable": [
        { "field": "status", "type": "select" },
        { "field": "prospectDate", "type": "date" },
        { "field": "startDate", "type": "date" },
        { "field": "endDate", "type": "date" },
        { "field": "quoteSent", "type": "date" },
        { "field": "quoteAccepted", "type": "date" },
        { "field": "invoiceSent", "type": "date" },
        { "field": "invoicePaid", "type": "date" },
        { "field": "invoiceNumber", "type": "text" },
        { "field": "folderUrl", "type": "url" }
      ]
    }
  }
}
